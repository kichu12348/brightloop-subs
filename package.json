{
  "name": "brightloop-subs",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @brightloop/api dev",
    "dev:web": "bun --filter @brightloop/web dev",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "eslint .",
    "test": "bun test",
    "seed": "bun --filter @brightloop/api seed"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
