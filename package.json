{
  "name": "brightloop-subs",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @brightloop/api dev",
    "dev:web": "bun --filter @brightloop/web dev",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "eslint .",
    "test": "bun test",
    "seed": "bun --filter @brightloop/api seed",
    "db:init": "bun --filter @brightloop/api db:generate && bun --filter @brightloop/api db:push"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0"
  }
}